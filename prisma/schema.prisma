generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Map {
  id            String   @id @default(uuid())
  name          String
  width         Int?
  height        Int?
  status        String   @default("processing")
  maxNativeZoom Int?
  calibration   Json?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model User {
  id                 String               @id @default(uuid())
  username           String               @unique
  password           String
  name               String?
  role               String               @default("user")
  maps               Map[]
  feedbacks          Feedback[]
  replies            FeedbackReply[]
  simulationSessions SimulationSession[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model SimulationSession {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mapId     String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DocumentSection {
  id        String           @id @default(uuid())
  roman     String
  title     String
  subtitle  String?
  type      String           @default("document") // "document" or "video"
  items     Document[]
  folders   DocumentFolder[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model DocumentFolder {
  id        String          @id @default(uuid())
  name      String
  order     Int             @default(0)
  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items     Document[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([sectionId])
}

model Document {
  id             String          @id @default(uuid())
  title          String
  type           String          // "pdf", "video", "drawing", "doc", "word"
  classified     Boolean         @default(false)
  url            String?
  folderId       String?
  folderRelation DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  order          Int             @default(0)
  sectionId      String
  section        DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sectionId])
  @@index([folderId])
}

model Vehicle {
  id        String   @id // e.g. "HPK-2.5", "TPK", "KH-1", etc.
  name      String
  desc      String?
  l         Float
  r         Float
  t         Float
  materials String?  @db.Text
  unit      String   @default("cái")
  isCar     Boolean  @default(false)
  consumptionConfig Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  content    String          @db.Text
  status     String          @default("PENDING") // "PENDING", "RESOLVED"
  adminRead  Boolean         @default(false)
  userRead   Boolean         @default(true)
  replies    FeedbackReply[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
}

model FeedbackReply {
  id         String   @id @default(uuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@index([userId])
}
